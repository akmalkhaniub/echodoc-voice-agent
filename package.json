{
  "name": "echodoc-voice-agent",
  "version": "1.0.0",
  "description": "Sub-Second Clinical Voice Scribe & Diagnostic Copilot powered by AssemblyAI Streaming STT",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "build": "tsc && node scripts/copy-public.mjs",
    "typecheck": "tsc -p tsconfig.test.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "verify": "npm run typecheck && npm run test:offline && npm run build",
    "test": "npm run typecheck && tsx test/simulate_consultation.ts && tsx test/unit_offline.ts && tsx test/metrics.test.ts && tsx test/server_ws.test.ts && tsx test/verify_assemblyai_v3.ts",
    "test:offline": "npm run typecheck && tsx test/simulate_consultation.ts && tsx test/unit_offline.ts && tsx test/metrics.test.ts && tsx test/server_ws.test.ts",
    "test:unit": "tsx test/unit_offline.ts && tsx test/metrics.test.ts",
    "test:live": "tsx test/verify_assemblyai_v3.ts",
    "test:sim": "tsx test/simulate_consultation.ts",
    "docker:build": "docker build -t echodoc-voice-agent:latest .",
    "docker:run": "docker run -d -p 3000:3000 --name echodoc-voice-agent echodoc-voice-agent:latest",
    "docker:compose": "docker compose up -d",
    "deploy:aws": "sh deploy/aws/deploy.sh",
    "deploy:gcp": "sh deploy/gcp/deploy.sh",
    "deploy:azure": "sh deploy/azure/deploy.sh",
    "deploy:k8s": "kubectl apply -k deploy/k8s/",
    "tunnel": "powershell -ExecutionPolicy Bypass -File deploy/free/tunnel.ps1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "assemblyai": "^4.9.0",
    "dotenv": "^16.4.7",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "assemblyai",
    "voice-agent",
    "real-time",
    "speech-to-text",
    "clinical-scribe",
    "soap-notes",
    "hackathon"
  ],
  "author": "Antigravity Builder",
  "license": "MIT"
}
