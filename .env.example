# AssemblyAI API Key (get from https://www.assemblyai.com/dashboard)
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# Optional: Port configuration (default is 3000)
PORT=3000

# Optional: Mock mode for development without live AssemblyAI key
# When set to 'true', simulates sub-second streaming STT responses
MOCK_STREAMING=false
